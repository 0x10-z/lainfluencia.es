---
import '../styles/global.css'
import Navbar from '../components/Navbar.astro'
import DetailSidebar from '../components/DetailSidebar.tsx'

import eventsData    from '../data/events.json'
import entitiesData  from '../data/entities.json'
import relationsData from '../data/relations.json'
import sourcesData   from '../data/sources.json'

import type { Event, Entity, Relation, Source } from '../types'

interface Props {
  title: string
  description?: string
  ogImage?: string
}

const {
  title,
  description = 'Investigación periodística sobre corrupción política en España. Datos verificados, fuentes documentadas.',
  ogImage,
} = Astro.props

const canonicalURL = new URL(Astro.url.pathname, Astro.site)
const fullTitle = title === 'La Influencia' ? title : `${title} — La Influencia`

const events    = eventsData.events    as Event[]
const entities  = entitiesData.entities as Entity[]
const relations = relationsData.relations as Relation[]
const sources   = sourcesData.sources   as Source[]
---

<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  {ogImage && <meta property="og:image" content={ogImage} />}
  <meta property="og:locale" content="es_ES" />
  <meta property="og:site_name" content="La Influencia" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body>
  <!-- Barra de progreso de lectura -->
  <div id="read-progress" style="position:fixed;top:52px;left:0;height:2px;width:0%;background:var(--red);z-index:850;transition:width 0.1s linear;pointer-events:none;"></div>
  <!-- Tooltip global (position:fixed para no cortarse con overflow:hidden) -->
  <div id="tt"></div>

  <div class="layout">
    <Navbar />
    <div class="main-content" style="display:flex; flex-direction:column;">
      <div style="flex:1;">
        <slot />
      </div>
      <footer style="border-top:1px solid var(--line); padding:1.25rem 3vw; background:var(--bg2);">
        <p style="font-family:var(--fm); font-size:0.65rem; color:var(--txt3); margin:0; line-height:1.8; letter-spacing:0.04em; max-width:700px;">
          La imputación o procesamiento judicial no implica condena penal. Todos los investigados son
          inocentes hasta sentencia judicial firme. Fuentes documentadas en cada hecho. Datos auditables y públicos.
        </p>
      </footer>
    </div>
  </div>

  <!-- Sidebar global de detalle — disponible en todas las páginas -->
  <DetailSidebar
    events={events}
    entities={entities}
    relations={relations}
    sources={sources}
    client:load
  />

  <script>
    const bar = document.getElementById('read-progress')!
    function updateProgress() {
      const scrolled = window.scrollY
      const total = document.documentElement.scrollHeight - window.innerHeight
      bar.style.width = total > 0 ? (scrolled / total * 100) + '%' : '0%'
    }
    window.addEventListener('scroll', updateProgress, { passive: true })
    updateProgress()

    // Ocultar la barra cuando el sidebar está abierto
    const _origOpen = window.openDetailSidebar
    const _origClose = window.closeDetailSidebar
    Object.defineProperty(window, 'openDetailSidebar', {
      get() { return this._openDetailSidebar },
      set(fn) {
        this._openDetailSidebar = fn
          ? (...args: Parameters<typeof fn>) => { bar.style.opacity = '0'; fn(...args) }
          : fn
      },
      configurable: true,
    })
    Object.defineProperty(window, 'closeDetailSidebar', {
      get() { return this._closeDetailSidebar },
      set(fn) {
        this._closeDetailSidebar = fn
          ? (...args: Parameters<typeof fn>) => { bar.style.opacity = '1'; fn(...args) }
          : fn
      },
      configurable: true,
    })
  </script>

  <script>
    const observer = new IntersectionObserver(
      entries => entries.forEach(e => {
        if (e.isIntersecting) { e.target.classList.add('visible'); observer.unobserve(e.target) }
      }),
      { threshold: 0.06, rootMargin: '0px 0px -20px 0px' }
    )
    document.querySelectorAll('.fade-up').forEach(el => observer.observe(el))
  </script>

  <script>
    // Tooltip global — position:fixed para no cortarse con overflow:hidden
    const tt = document.getElementById('tt')!
    const GAP = 10
    let current: Element | null = null

    function show(el: Element) {
      const text = el.getAttribute('data-tooltip')
      if (!text) return
      current = el
      tt.textContent = text
      tt.classList.add('visible')
      position(el)
    }

    function hide() {
      current = null
      tt.classList.remove('visible')
    }

    function position(el: Element) {
      const r = el.getBoundingClientRect()
      const tw = tt.offsetWidth
      const th = tt.offsetHeight
      // Intentar arriba; si no cabe, poner abajo
      let top = r.top - th - GAP
      if (top < 8) top = r.bottom + GAP
      // Centrar horizontalmente, clamped a viewport
      let left = r.left + r.width / 2 - tw / 2
      left = Math.max(8, Math.min(left, window.innerWidth - tw - 8))
      tt.style.top = top + 'px'
      tt.style.left = left + 'px'
    }

    document.addEventListener('mouseover', e => {
      const el = (e.target as Element).closest('[data-tooltip]')
      if (el && el !== current) show(el)
    })
    document.addEventListener('mouseout', e => {
      const el = (e.target as Element).closest('[data-tooltip]')
      if (el) hide()
    })
    document.addEventListener('scroll', () => { if (current) position(current) }, { passive: true })
  </script>
</body>
</html>
