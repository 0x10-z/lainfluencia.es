---
import '../styles/global.css'
import Sidebar from '../components/Sidebar.astro'

interface Props {
  title: string
  description?: string
  ogImage?: string
}

const {
  title,
  description = 'Investigación periodística sobre corrupción política en España. Datos verificados, fuentes documentadas.',
  ogImage,
} = Astro.props

const canonicalURL = new URL(Astro.url.pathname, Astro.site)
const fullTitle = title === 'La Influencia' ? title : `${title} — La Influencia`
---

<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  {ogImage && <meta property="og:image" content={ogImage} />}
  <meta property="og:locale" content="es_ES" />
  <meta property="og:site_name" content="La Influencia" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body>
  <div class="layout">
    <Sidebar />
    <div class="main-content">
      <slot />
      <footer style="border-top:1px solid var(--line); padding:1.5rem 2rem; margin-top:3rem;">
        <p style="font-family:'IBM Plex Mono',monospace; font-size:0.62rem; color:var(--txt3); margin:0; line-height:1.7;">
          La imputación o procesamiento no implica condena. Todos los investigados son inocentes hasta sentencia firme.<br />
          Fuentes documentadas en cada hecho. Datos auditables y públicos.
        </p>
      </footer>
    </div>
  </div>

  <script>
    const observer = new IntersectionObserver(
      entries => entries.forEach(e => {
        if (e.isIntersecting) { e.target.classList.add('visible'); observer.unobserve(e.target) }
      }),
      { threshold: 0.08, rootMargin: '0px 0px -24px 0px' }
    )
    document.querySelectorAll('.fade-up').forEach(el => observer.observe(el))
  </script>
</body>
</html>
