---
const nav = [
  { href: '/cronologia', label: 'Cronología' },
  { href: '/red',        label: 'Red' },
  { href: '/documentos', label: 'Documentos' },
  { href: '/buscar',     label: 'Buscar' },
]

const pathname = Astro.url.pathname
---

<header>
  <!-- Franja superior: nombre + fecha -->
  <div style="border-bottom: 1px solid var(--line); background: var(--bg2);">
    <div class="container" style="display:flex; align-items:center; justify-content:space-between; padding-top:0.6rem; padding-bottom:0.6rem;">
      <span style="font-family:'IBM Plex Mono',monospace; font-size:0.62rem; color:var(--txt3); letter-spacing:0.06em; text-transform:uppercase;">
        Periodismo de investigación · España
      </span>
      <span style="font-family:'IBM Plex Mono',monospace; font-size:0.62rem; color:var(--txt3); letter-spacing:0.04em;">
        D.P. 77/2024 — Caso Zapatero
      </span>
    </div>
  </div>

  <!-- Logotipo -->
  <div style="background: var(--bg2); border-bottom: 3px double var(--txt);">
    <div class="container" style="display:flex; align-items:center; justify-content:space-between; padding-top:0.9rem; padding-bottom:0.9rem;">
      <a href="/" style="text-decoration:none;">
        <div style="font-family:'Cormorant Garamond',serif; font-size:2rem; font-weight:700; color:var(--txt); letter-spacing:-0.02em; line-height:1;">
          La Influencia
        </div>
        <div style="font-family:'IBM Plex Mono',monospace; font-size:0.58rem; color:var(--txt3); letter-spacing:0.12em; text-transform:uppercase; margin-top:2px;">
          Investigación · Corrupción · Datos verificados
        </div>
      </a>

      <!-- Nav links -->
      <nav style="display:flex; align-items:center; gap:0;">
        {nav.map(({ href, label }) => {
          const active = pathname === href || (href !== '/' && pathname.startsWith(href))
          return (
            <a href={href} style={`
              font-family: 'IBM Plex Mono', monospace;
              font-size: 0.68rem;
              letter-spacing: 0.06em;
              text-transform: uppercase;
              color: ${active ? 'var(--red)' : 'var(--txt2)'};
              padding: 6px 16px;
              text-decoration: none;
              border-left: 1px solid var(--line);
              transition: color 0.12s;
            `}>
              {label}
            </a>
          )
        })}
      </nav>
    </div>
  </div>
</header>
