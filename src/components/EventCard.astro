---
import type { Event, Entity, Source } from '../types'
import { formatDate, getEventTypeLabel, getSourceById, getEntityById } from '../utils'
import ImpactBar from './ImpactBar.astro'
import SourceChip from './SourceChip.astro'

interface Props {
  event: Event
  entities: Entity[]
  sources: Source[]
  expandable?: boolean
}

const { event, entities, sources, expandable = true } = Astro.props
const dateStr = formatDate(event.date, event.date_precision)
const typeLabel = getEventTypeLabel(event.type)

const eventSources = event.sources.map(id => getSourceById(id, sources)).filter(Boolean) as Source[]
const eventEntities = event.entities.map(id => getEntityById(id, entities)).filter(Boolean) as Entity[]

const verifiedIcon = event.verified === true ? '✓ verificado' : event.verified === 'partial' ? '~ parcial' : '? sin verificar'
const verifiedColor = event.verified === true ? 'var(--green)' : event.verified === 'partial' ? 'var(--gold)' : 'var(--txt3)'

const accentColor = 'var(--red)'
---

<article
  class="event-card fade-up"
  style={`
    background: var(--bg2);
    border: 1px solid var(--line);
    border-left: 3px solid ${accentColor};
    overflow: hidden;
    ${event.pending ? 'opacity: 0.65;' : ''}
  `}
  data-event-id={event.id}
  data-cases={event.cases.join(',')}
  data-type={event.type}
  data-impact={event.impact}
>
  <!-- Cabecera siempre visible -->
  <div style="padding: 1.5rem 2rem;">
    <div style="display: flex; align-items: start; justify-content: space-between; gap: 1rem; margin-bottom: 0.8rem;">
      <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem;">
        <time
          datetime={event.date}
          style="
            font-family: var(--fm);
            font-size: 0.62rem;
            color: var(--txt3);
            white-space: nowrap;
            letter-spacing: 0.06em;
          "
        >
          {dateStr}
          {event.pending && (
            <span style="color: var(--gold); margin-left: 6px; font-size: 0.52rem; letter-spacing: 0.1em; text-transform: uppercase;">pendiente</span>
          )}
        </time>
        <span style="
          font-family: var(--fm);
          font-size: 0.48rem;
          color: var(--txt3);
          letter-spacing: 0.1em;
          text-transform: uppercase;
          border: 1px solid var(--line2);
          padding: 0.1rem 0.4rem;
        ">
          {typeLabel}
        </span>
      </div>
      <span
        title={verifiedIcon}
        style={`
          font-family: var(--fm);
          font-size: 0.5rem;
          color: ${verifiedColor};
          flex-shrink: 0;
          letter-spacing: 0.08em;
          text-transform: uppercase;
        `}
      >
        {verifiedIcon}
      </span>
    </div>

    <h3 style="
      font-family: var(--ft);
      font-size: 1.1rem;
      font-weight: 700;
      color: var(--txt);
      margin: 0 0 0.8rem;
      line-height: 1.25;
      letter-spacing: -0.01em;
    ">
      {expandable ? (
        <a href={`/eventos/${event.id}`} style="color: inherit; text-decoration: none;">{event.title}</a>
      ) : event.title}
    </h3>

    <ImpactBar impact={event.impact} />
  </div>

  <!-- Cuerpo expandible -->
  {expandable && (
    <details style="border-top: 1px solid var(--line);">
      <summary style="
        padding: 0.6rem 2rem;
        font-family: var(--fm);
        font-size: 0.52rem;
        color: var(--txt3);
        cursor: pointer;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        list-style: none;
        display: flex;
        align-items: center;
        gap: 6px;
        user-select: none;
        transition: color 0.15s;
      ">
        <span class="toggle-icon">▸</span> Ver detalles
      </summary>

      <div style="padding: 1.2rem 2rem; border-top: 1px solid var(--line); background: var(--bg3);">
        <p style="font-family: var(--fb); font-size: 0.88rem; color: var(--txt2); line-height: 1.75; margin: 0 0 1rem; max-width: 680px;">
          {event.description}
        </p>

        {event.notes && (
          <blockquote style="
            font-family: var(--ft);
            font-style: italic;
            font-size: 0.85rem;
            color: var(--txt2);
            margin: 0 0 1rem;
            padding: 0.4rem 0.9rem;
            border-left: 1px solid var(--line2);
            line-height: 1.65;
          ">
            {event.notes}
          </blockquote>
        )}

        {eventEntities.length > 0 && (
          <div style="margin-bottom: 1rem;">
            <p style="font-family: var(--fm); font-size: 0.46rem; color: var(--txt3); text-transform: uppercase; letter-spacing: 0.15em; margin: 0 0 0.5rem;">
              Actores implicados
            </p>
            <div style="display: flex; flex-wrap: wrap; gap: 5px;">
              {eventEntities.map(ent => (
                <a
                  href={`/personajes/${ent.id}`}
                  style="
                    font-family: var(--fm);
                    font-size: 0.55rem;
                    color: var(--txt3);
                    border: 1px solid var(--line2);
                    padding: 0.2rem 0.55rem;
                    text-decoration: none;
                    transition: color 0.15s;
                  "
                >
                  {ent.name}
                </a>
              ))}
            </div>
          </div>
        )}

        {eventSources.length > 0 && (
          <div>
            <p style="font-family: var(--fm); font-size: 0.46rem; color: var(--txt3); text-transform: uppercase; letter-spacing: 0.15em; margin: 0 0 0.5rem;">
              Fuentes documentales
            </p>
            <div style="display: flex; flex-direction: column; gap: 5px;">
              {eventSources.map(src => <SourceChip source={src} />)}
            </div>
          </div>
        )}
      </div>
    </details>
  )}
</article>

<style>
  details[open] .toggle-icon { transform: rotate(90deg); }
  .toggle-icon { display: inline-block; transition: transform 0.15s; }
</style>
