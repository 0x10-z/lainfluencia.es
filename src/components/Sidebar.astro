---
import casesData  from '../data/cases.json'
import eventsData from '../data/events.json'
import type { Case, Event } from '../types'

const cases  = casesData.cases   as Case[]
const events = eventsData.events as Event[]

const caseZ   = cases.find(c => c.id === 'dp-77-24')!
const eventsZ = events.filter(e => e.cases.includes('dp-77-24'))
const lastEv  = [...eventsZ].filter(e => !e.pending)
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())[0]

const pathname = Astro.url.pathname

const nav = [
  { href: '/',           label: 'Inicio',     icon: '◈' },
  { href: '/cronologia', label: 'Cronología', icon: '◷' },
  { href: '/red',        label: 'Red',        icon: '◎' },
  { href: '/documentos', label: 'Documentos', icon: '▤'  },
  { href: '/buscar',     label: 'Buscar',     icon: '⌕'  },
]

const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href)
---

<aside class="sidebar">
  <!-- Marca -->
  <div style="padding:1.1rem 1rem 0.9rem; border-bottom:1px solid var(--line);">
    <a href="/" style="text-decoration:none;">
      <div style="font-size:0.9rem; font-weight:600; color:var(--txt); letter-spacing:-0.02em; line-height:1.2;">
        La Influencia
      </div>
      <div style="font-family:'DM Mono',monospace; font-size:0.55rem; color:var(--txt3); letter-spacing:0.05em; text-transform:uppercase; margin-top:2px;">
        Investigación · Datos
      </div>
    </a>
  </div>

  <!-- Nav -->
  <nav style="padding:0.4rem 0; border-bottom:1px solid var(--line);">
    {nav.map(({ href, label, icon }) => (
      <a href={href} style={`
        display:flex; align-items:center; gap:7px;
        padding:5px 12px;
        font-size:0.78rem;
        font-weight:${isActive(href) ? '600' : '400'};
        color:${isActive(href) ? 'var(--txt)' : 'var(--txt2)'};
        background:${isActive(href) ? 'var(--card)' : 'transparent'};
        border-left:2px solid ${isActive(href) ? 'var(--red)' : 'transparent'};
        text-decoration:none;
        transition:background 0.1s;
      `}>
        <span style="font-size:0.65rem; opacity:0.6;">{icon}</span>
        {label}
      </a>
    ))}
  </nav>

  <!-- Expediente -->
  <div style="padding:0.9rem 1rem; border-bottom:1px solid var(--line);">
    <div style="font-family:'DM Mono',monospace; font-size:0.55rem; color:var(--txt3); text-transform:uppercase; letter-spacing:0.07em; margin-bottom:0.5rem;">
      Expediente
    </div>
    <div class="ficha" style="border-radius:4px;">
      {[
        { k: 'N.º',      v: 'D.P. 77/2024' },
        { k: 'Juzgado',  v: 'JCI Nº 2 · Madrid' },
        { k: 'Juez',     v: 'Calama' },
        { k: 'Estado',   v: 'Instrucción' },
        { k: 'Abierto',  v: 'Ene. 2024' },
      ].map(({ k, v }) => (
        <div class="ficha-row">
          <div class="ficha-label">{k}</div>
          <div class="ficha-value" style="font-size:0.72rem;">{v}</div>
        </div>
      ))}
    </div>
  </div>

  <!-- Cargos -->
  <div style="padding:0.9rem 1rem; flex:1; overflow-y:auto;">
    <div style="font-family:'DM Mono',monospace; font-size:0.55rem; color:var(--txt3); text-transform:uppercase; letter-spacing:0.07em; margin-bottom:0.5rem;">
      Cargos
    </div>
    <ul style="margin:0; padding:0; list-style:none; display:flex; flex-direction:column; gap:2px;">
      {caseZ.charges.map(charge => (
        <li style="font-size:0.72rem; color:var(--txt2); padding:3px 0; border-bottom:1px solid var(--line2); display:flex; gap:5px; align-items:start; line-height:1.4;">
          <span style="color:var(--red); flex-shrink:0; font-size:0.55rem; margin-top:3px; font-family:'DM Mono',monospace;">▸</span>
          {charge}
        </li>
      ))}
    </ul>
  </div>

  <!-- Disclaimer -->
  <div style="padding:0.75rem 1rem; border-top:1px solid var(--line);">
    <p style="font-family:'DM Mono',monospace; font-size:0.52rem; color:var(--txt3); margin:0; line-height:1.6;">
      La imputación no implica condena. Inocentes hasta sentencia firme.
    </p>
  </div>
</aside>
