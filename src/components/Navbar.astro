---
import eventsData from '../data/events.json'
import entitiesData from '../data/entities.json'
import type { Event, Entity } from '../types'
import NavSearch from './NavSearch.tsx'

const events = eventsData.events as Event[]
const entities = entitiesData.entities as Entity[]

const pathname = Astro.url.pathname

const nav = [
  { href: '/',            label: 'Inicio' },
  { href: '/cronologia',  label: 'Cronología' },
  { href: '/personajes',  label: 'Actores' },
  { href: '/red',         label: 'Red' },
  { href: '/documentos',  label: 'Archivo' },
]

const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href)
---

<nav class="topnav">

  <!-- Identidad -->
  <a href="/" style="
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    padding: 0 2rem;
    height: 52px;
    text-decoration: none;
    flex-shrink: 0;
    border-right: 1px solid var(--line);
  ">
    <span style="
      font-family: var(--ft);
      font-size: 1.35rem;
      font-weight: 900;
      color: var(--txt);
      letter-spacing: -0.01em;
      line-height: 1;
    ">
      La <em style="color:var(--red);font-style:italic;">Influencia</em>
    </span>
    <span style="
      font-family: var(--fm);
      font-size: 0.44rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--txt3);
      border: 1px solid var(--line2);
      padding: 0.1rem 0.35rem;
      border-radius: 3px;
      position: relative;
      top: -1px;
    ">
      archivo
    </span>
  </a>

  <!-- Nav links — centrados -->
  <div style="
    display: flex;
    align-items: stretch;
    height: 52px;
    flex: 1;
    padding: 0 1rem;
  ">
    {nav.map(({ href, label }) => (
      <a href={href} style={`
        display: flex;
        align-items: center;
        padding: 0 1.1rem;
        font-family: var(--fm);
        font-size: 0.55rem;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: ${isActive(href) ? 'var(--txt)' : 'var(--txt3)'};
        border-bottom: 1px solid ${isActive(href) ? 'var(--red)' : 'transparent'};
        border-top: 1px solid transparent;
        text-decoration: none;
        white-space: nowrap;
        transition: color 0.2s;
      `}>
        {label}
      </a>
    ))}
  </div>

  <!-- Indicador + búsqueda -->
  <div style="display: flex; align-items: center; gap: 0.6rem; padding-right: 0.5rem;">
    <span style="
      font-family: var(--fm);
      font-size: 0.48rem;
      letter-spacing: 0.12em;
      color: var(--txt3);
      text-transform: uppercase;
      display: flex;
      align-items: center;
      gap: 0.4rem;
    ">
      <span class="blink-dot" />
      activo
    </span>
    <NavSearch events={events} entities={entities} client:load />
  </div>
</nav>
