---
import type { Entity } from '../types'
import { getStatusLabel, getStatusColor } from '../utils'
import CaseTag from './CaseTag.astro'

interface Props {
  entity: Entity
  compact?: boolean
}

const { entity, compact = false } = Astro.props
const statusColor = getStatusColor(entity.status)
const statusLabel = getStatusLabel(entity.status)

const typeIcon: Record<string, string> = {
  person: '◉',
  company: '▣',
  institution: '⬡',
  account: '◈',
}
---

<a
  href={`/personajes/${entity.id}`}
  style={`
    display: block;
    background: var(--bg2);
    border: 1px solid var(--line);
    border-left: 2px solid ${statusColor};
    padding: ${compact ? '0.85rem 1.25rem' : '1.1rem 1.5rem'};
    text-decoration: none;
    transition: background 0.15s;
  `}
  class="entity-card"
>
  <div style="display: flex; align-items: start; justify-content: space-between; gap: 1rem;">
    <div style="min-width: 0;">
      <div style="display: flex; align-items: baseline; gap: 8px; margin-bottom: 5px;">
        <span style="font-family: var(--fm); font-size: 0.55rem; color: var(--txt3);">
          {typeIcon[entity.type] ?? '○'}
        </span>
        <span style="
          font-family: var(--ft);
          font-size: ${compact ? '0.88rem' : '1rem'};
          font-weight: 700;
          color: var(--txt);
          white-space: nowrap;
          overflow: hidden;
          text-overflow: ellipsis;
        ">
          {entity.name}
        </span>
      </div>
      {!compact && (
        <p style="
          font-family: var(--fm);
          font-size: 0.58rem;
          color: var(--txt3);
          margin: 0 0 0.6rem;
          line-height: 1.5;
          letter-spacing: 0.03em;
        ">
          {entity.role}
        </p>
      )}
      <div style="display: flex; flex-wrap: wrap; gap: 5px; align-items: center;">
        <span class="status-pill" style={`border-color: ${statusColor}; color: ${statusColor};`}>
          {statusLabel}
        </span>
        {entity.cases.map(c => <CaseTag caseId={c} />)}
      </div>
    </div>
  </div>
</a>

<style>
  .entity-card:hover {
    background: var(--bg3) !important;
  }
</style>
