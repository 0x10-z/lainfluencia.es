---
import { getCaseColor } from '../utils'

interface Props {
  caseId: string
}

const { caseId } = Astro.props

const labels: Record<string, string> = {
  'dp-77-24': 'Zapatero',
  'caso-koldo': 'Koldo',
}

const label = labels[caseId] ?? caseId
const color = getCaseColor(caseId)
---

<span style={`
  font-family: var(--fm);
  font-size: 0.46rem;
  font-weight: 400;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  padding: 0.12rem 0.45rem;
  border: 1px solid ${color};
  color: ${color};
  display: inline-block;
`}>
  {label}
</span>
