---
import { getImpactLabel, getImpactColor } from '../utils'

interface Props {
  impact: 1 | 2 | 3 | 4 | 5
  showLabel?: boolean
}

const { impact, showLabel = true } = Astro.props
const color = getImpactColor(impact)
const label = getImpactLabel(impact)
---

<div style="display: flex; align-items: center; gap: 8px;" title={`Impacto: ${label}`}>
  <div class="impact-bar" style={`color: ${color}`}>
    {Array.from({ length: 5 }, (_, i) => (
      <span class={i < impact ? 'filled' : ''} />
    ))}
  </div>
  {showLabel && (
    <span style={`
      font-family: var(--fm);
      font-size: 0.5rem;
      color: ${color};
      letter-spacing: 0.1em;
      text-transform: uppercase;
    `}>
      {label}
    </span>
  )}
</div>
