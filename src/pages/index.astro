---
import Base from '../layouts/Base.astro'
import EventCard from '../components/EventCard.astro'
import CaseTag from '../components/CaseTag.astro'

import casesData from '../data/cases.json'
import eventsData from '../data/events.json'
import entitiesData from '../data/entities.json'
import sourcesData from '../data/sources.json'

import type { Event, Entity, Source, Case } from '../types'

const cases = casesData.cases as Case[]
const events = eventsData.events as Event[]
const entities = entitiesData.entities as Entity[]
const sources = sourcesData.sources as Source[]

// Eventos de mayor impacto para el hero
const topEvents = events
  .filter(e => !e.pending)
  .sort((a, b) => b.impact - a.impact)
  .slice(0, 3)

// Cifras clave
const stats = {
  events: events.length,
  entities: entities.length,
  sources: sources.length,
  investigated: entities.filter(e => e.status === 'investigated').length,
  accused: entities.filter(e => e.status === 'accused').length,
}
---

<Base
  title="La Influencia"
  description="Periodismo de investigación sobre el Caso Zapatero y el Caso Koldo. Datos verificados, fuentes documentadas."
>
  <!-- Hero -->
  <section style="
    border-bottom: 1px solid var(--line);
    padding: 5rem 0 4rem;
  ">
    <div class="container">
      <p style="
        font-family: 'IBM Plex Mono', monospace;
        font-size: 0.75rem;
        color: var(--txt3);
        letter-spacing: 0.08em;
        text-transform: uppercase;
        margin: 0 0 1.5rem;
      ">
        Periodismo de investigación · España
      </p>

      <h1 style="
        font-family: 'Playfair Display', serif;
        font-size: clamp(2.5rem, 6vw, 4.5rem);
        font-weight: 900;
        line-height: 1.05;
        margin: 0 0 1.5rem;
        max-width: 820px;
        color: var(--txt);
      ">
        La red de influencia<br />
        <em style="color: var(--txt2); font-style: italic;">que el dinero público</em><br />
        no debería comprar
      </h1>

      <p style="
        font-size: 1.1rem;
        color: var(--txt2);
        max-width: 600px;
        line-height: 1.65;
        margin: 0 0 2.5rem;
      ">
        Dos casos judiciales. Decenas de investigados. Millones en contratos públicos.
        Este sitio documenta los hechos verificados con sus fuentes, construyendo
        una cronología auditable de la corrupción política en España.
      </p>

      <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
        <a
          href="/cronologia"
          style="
            font-family: 'IBM Plex Mono', monospace;
            font-size: 0.85rem;
            color: var(--txt);
            border: 1px solid var(--line2);
            padding: 10px 20px;
            text-decoration: none;
            letter-spacing: 0.04em;
          "
        >
          Ver cronología →
        </a>
        <a
          href="/red"
          style="
            font-family: 'IBM Plex Mono', monospace;
            font-size: 0.85rem;
            color: var(--txt2);
            border: 1px solid var(--line);
            padding: 10px 20px;
            text-decoration: none;
            letter-spacing: 0.04em;
          "
        >
          Ver red de relaciones
        </a>
      </div>
    </div>
  </section>

  <!-- Cifras clave -->
  <section style="border-bottom: 1px solid var(--line); padding: 3rem 0;">
    <div class="container">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 0; border: 1px solid var(--line);">
        {[
          { n: stats.events, label: 'Hechos documentados' },
          { n: stats.entities, label: 'Actores identificados' },
          { n: stats.sources, label: 'Fuentes verificadas' },
          { n: stats.investigated, label: 'Investigados' },
          { n: cases.length, label: 'Casos judiciales' },
        ].map((s, i) => (
          <div style={`
            padding: 1.5rem;
            border-right: ${i < 4 ? '1px solid var(--line)' : 'none'};
            text-align: center;
          `}>
            <div style="
              font-family: 'Playfair Display', serif;
              font-size: 2.5rem;
              font-weight: 900;
              color: var(--txt);
              line-height: 1;
              margin-bottom: 0.4rem;
            ">
              {s.n}
            </div>
            <div style="
              font-family: 'IBM Plex Mono', monospace;
              font-size: 0.68rem;
              color: var(--txt3);
              text-transform: uppercase;
              letter-spacing: 0.05em;
            ">
              {s.label}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Los casos -->
  <section style="border-bottom: 1px solid var(--line); padding: 4rem 0;">
    <div class="container">
      <h2 style="
        font-size: 0.75rem;
        font-family: 'IBM Plex Mono', monospace;
        color: var(--txt3);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        margin: 0 0 2rem;
        font-weight: 400;
      ">
        Los casos
      </h2>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 0; border: 1px solid var(--line);">
        {cases.map((c, i) => (
          <div style={`
            padding: 2rem;
            border-right: ${i === 0 ? '1px solid var(--line)' : 'none'};
            border-left: 3px solid ${c.color};
          `}>
            <div style="margin-bottom: 1rem;">
              <CaseTag caseId={c.id} />
            </div>
            <h3 style="
              font-family: 'Playfair Display', serif;
              font-size: 1.2rem;
              font-weight: 700;
              color: var(--txt);
              margin: 0 0 0.5rem;
              line-height: 1.3;
            ">
              {c.name}
            </h3>
            <p style="font-family: 'IBM Plex Mono', monospace; font-size: 0.75rem; color: var(--txt3); margin: 0 0 1rem;">
              {c.court}
            </p>
            <div>
              <p style="font-family: 'IBM Plex Mono', monospace; font-size: 0.7rem; color: var(--txt3); text-transform: uppercase; letter-spacing: 0.05em; margin: 0 0 0.5rem;">
                Cargos
              </p>
              <ul style="margin: 0; padding: 0; list-style: none;">
                {c.charges.map(charge => (
                  <li style="font-size: 0.85rem; color: var(--txt2); padding: 3px 0; border-bottom: 1px solid var(--line);">
                    {charge}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Narrativa intro -->
  <section style="border-bottom: 1px solid var(--line); padding: 4rem 0;">
    <div class="container" style="max-width: 720px;">
      <h2 style="
        font-family: 'Playfair Display', serif;
        font-size: 1.8rem;
        font-weight: 700;
        color: var(--txt);
        margin: 0 0 1.5rem;
        line-height: 1.3;
      ">
        Cómo funciona este sitio
      </h2>

      <div style="font-size: 0.95rem; color: var(--txt2); line-height: 1.75;">
        <p>
          Cada hecho documentado en esta investigación proviene de una fuente verificable:
          autos judiciales, informes de la UDEF o la UCO, o prensa contrastada.
          No hay interpretaciones sin respaldo documental.
        </p>
        <p>
          Los datos están organizados en cinco capas: los <strong style="color:var(--txt);">casos</strong> como marco jurídico,
          las <strong style="color:var(--txt);">entidades</strong> como actores, las <strong style="color:var(--txt);">relaciones</strong> como vínculos documentados,
          los <strong style="color:var(--txt);">eventos</strong> como hechos cronológicos y las <strong style="color:var(--txt);">fuentes</strong> como evidencias.
        </p>
        <p>
          El código fuente y los datos son públicos y auditables. Si encuentras un error o tienes
          nueva documentación, el proceso para contribuir está explicado en el repositorio.
        </p>
      </div>
    </div>
  </section>

  <!-- Eventos destacados -->
  <section style="padding: 4rem 0;">
    <div class="container">
      <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 2rem;">
        <h2 style="
          font-size: 0.75rem;
          font-family: 'IBM Plex Mono', monospace;
          color: var(--txt3);
          text-transform: uppercase;
          letter-spacing: 0.08em;
          margin: 0;
          font-weight: 400;
        ">
          Hechos de mayor impacto
        </h2>
        <a href="/cronologia" style="
          font-family: 'IBM Plex Mono', monospace;
          font-size: 0.72rem;
          color: var(--txt3);
          text-decoration: none;
          letter-spacing: 0.04em;
        ">
          Ver todos →
        </a>
      </div>

      <div style="display: flex; flex-direction: column; gap: 1px; background: var(--line);">
        {topEvents.map(event => (
          <EventCard event={event} entities={entities} sources={sources} expandable={true} />
        ))}
      </div>
    </div>
  </section>
</Base>
