---
import Base from '../layouts/Base.astro'
import type { Event, Entity, Source, Case } from '../types'
import { formatDate, getImpactColor, getImpactLabel, getStatusColor, getStatusLabel } from '../utils'

import casesData    from '../data/cases.json'
import eventsData   from '../data/events.json'
import entitiesData from '../data/entities.json'
import sourcesData  from '../data/sources.json'

const caseZ     = (casesData.cases as Case[]).find(c => c.id === 'dp-77-24')!
const allEvents = eventsData.events as Event[]
const entities  = entitiesData.entities as Entity[]
const sources   = sourcesData.sources as Source[]

const eventsZ   = allEvents.filter(e => e.cases.includes('dp-77-24'))
const entitiesZ = entities.filter(e => e.cases.includes('dp-77-24'))
const sourcesZ  = sources.filter(s => s.cases.includes('dp-77-24'))

const latest = [...eventsZ]
  .filter(e => !e.pending)
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())
  .slice(0, 10)

const critical = eventsZ.filter(e => e.impact === 5 && !e.pending)
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())

const investigated = entitiesZ
  .filter(e => e.type === 'person' && ['investigated','accused','convicted'].includes(e.status))

const pending = eventsZ.find(e => e.pending)
---

<Base title="La Influencia" description="Investigación sobre el Caso Zapatero. Datos verificados, fuentes documentadas.">
<div style="padding:2rem; max-width:960px;">

  <!-- ── Cabecera del expediente ───────────────────── -->
  <div style="margin-bottom:1.75rem;">
    <div style="display:flex; align-items:start; justify-content:space-between; gap:1rem; flex-wrap:wrap;">
      <div>
        <h1 style="font-size:1.25rem; font-weight:600; letter-spacing:-0.025em; margin-bottom:0.25rem;">
          Caso Zapatero / Plus Ultra
        </h1>
        <p style="font-size:0.82rem; color:var(--txt2); margin:0; max-width:560px; line-height:1.55;">
          Investigación sobre el rescate de 53&nbsp;M€ a Plus Ultra. El juez Calama imputó
          al expresidente Zapatero el 18&nbsp;may.&nbsp;2026 por cuatro delitos.
        </p>
      </div>
      {pending && (
        <div style="background:var(--gold-bg); border:1px solid #dcc870; border-radius:5px; padding:6px 10px; flex-shrink:0;">
          <div style="font-family:'DM Mono',monospace; font-size:0.55rem; color:var(--gold); text-transform:uppercase; letter-spacing:0.07em; margin-bottom:2px;">Próximo</div>
          <div style="font-size:0.75rem; color:var(--txt); font-weight:500; line-height:1.3;">{pending.title}</div>
          <div style="font-family:'DM Mono',monospace; font-size:0.6rem; color:var(--txt3); margin-top:2px;">{formatDate(pending.date, pending.date_precision)}</div>
        </div>
      )}
    </div>
  </div>

  <!-- ── Ficha del expediente ──────────────────────── -->
  <div class="ficha" style="margin-bottom:1.5rem;">
    <div style="display:grid; grid-template-columns:repeat(4,1fr);">
      {[
        { k: 'Nº expediente',  v: 'D.P. 77/2024' },
        { k: 'Juzgado',        v: 'JCI Nº 2 · Madrid' },
        { k: 'Juez instructor',v: 'José Luis Calama' },
        { k: 'Estado',         v: 'En instrucción' },
      ].map(({ k, v }, i, arr) => (
        <div style={`padding:10px 14px; background:var(--bg2); border-right:${i < arr.length-1 ? '1px solid var(--line2)' : 'none'};`}>
          <div style="font-family:'DM Mono',monospace; font-size:0.55rem; color:var(--txt3); text-transform:uppercase; letter-spacing:0.07em; margin-bottom:3px;">{k}</div>
          <div style="font-size:0.8rem; font-weight:500; color:var(--txt);">{v}</div>
        </div>
      ))}
    </div>
    <div style="border-top:1px solid var(--line2); padding:10px 14px; background:var(--bg2);">
      <div style="font-family:'DM Mono',monospace; font-size:0.55rem; color:var(--txt3); text-transform:uppercase; letter-spacing:0.07em; margin-bottom:5px;">Delitos imputados</div>
      <div style="display:flex; flex-wrap:wrap; gap:6px;">
        {caseZ.charges.map(charge => (
          <span style="font-size:0.75rem; color:var(--txt2); background:var(--red-bg); border:1px solid #f0c0bc; border-radius:3px; padding:2px 8px;">
            {charge}
          </span>
        ))}
      </div>
    </div>
  </div>

  <!-- ── Métricas ──────────────────────────────────── -->
  <div style="display:grid; grid-template-columns:repeat(4,1fr); gap:8px; margin-bottom:1.75rem;">
    {[
      { n: eventsZ.length,      label:'Eventos',   href:'/cronologia', color:'var(--txt)' },
      { n: entitiesZ.length,    label:'Actores',   href:'/red',        color:'var(--txt)' },
      { n: sourcesZ.length,     label:'Fuentes',   href:'/documentos', color:'var(--txt)' },
      { n: critical.length,     label:'Críticos',  href:'/cronologia', color:'var(--red)'  },
    ].map(({ n, label, href, color }) => (
      <a href={href} style="display:block; background:var(--card); border:1px solid var(--line); border-radius:6px; padding:12px 14px; text-decoration:none;" class="card-hover">
        <div style={`font-size:1.5rem; font-weight:700; letter-spacing:-0.03em; color:${color}; line-height:1; margin-bottom:3px;`}>{n}</div>
        <div style="font-family:'DM Mono',monospace; font-size:0.58rem; color:var(--txt3); text-transform:uppercase; letter-spacing:0.06em;">{label}</div>
      </a>
    ))}
  </div>

  <!-- ── Cuerpo: dos columnas ─────────────────────── -->
  <div style="display:grid; grid-template-columns:1fr 240px; gap:1.5rem; align-items:start;">

    <!-- Eventos recientes -->
    <div>
      <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:0.75rem;">
        <span style="font-size:0.75rem; font-weight:600; color:var(--txt);">Eventos recientes</span>
        <a href="/cronologia" style="font-family:'DM Mono',monospace; font-size:0.6rem; color:var(--txt3); letter-spacing:0.03em;">ver todos →</a>
      </div>
      <div class="ficha">
        {latest.map((ev, i) => {
          const ic = getImpactColor(ev.impact)
          return (
            <a href={`/eventos/${ev.id}`}
              class="card-hover"
              style={`
                display:grid; grid-template-columns:80px 1fr;
                border-bottom:${i < latest.length-1 ? '1px solid var(--line2)' : 'none'};
                text-decoration:none;
                border-left:3px solid ${ev.impact === 5 ? 'var(--red)' : ev.impact === 4 ? 'var(--gold)' : 'var(--line)'};
              `}>
              <!-- Fecha -->
              <div style="padding:9px 10px; border-right:1px solid var(--line2); background:var(--bg2); display:flex; flex-direction:column; justify-content:center; gap:2px;">
                <time style="font-family:'DM Mono',monospace; font-size:0.6rem; color:var(--txt3); letter-spacing:0.02em; line-height:1.4; display:block;">
                  {formatDate(ev.date, ev.date_precision)}
                </time>
                <span style={`font-family:'DM Mono',monospace; font-size:0.55rem; color:${ic}; text-transform:uppercase; letter-spacing:0.06em;`}>
                  {getImpactLabel(ev.impact)}
                </span>
              </div>
              <!-- Título -->
              <div style="padding:9px 12px; display:flex; align-items:center;">
                <span style="font-size:0.8rem; font-weight:500; color:var(--txt); line-height:1.35; letter-spacing:-0.01em;">
                  {ev.title}
                </span>
              </div>
            </a>
          )
        })}
      </div>
    </div>

    <!-- Lateral: personas + eventos críticos -->
    <div style="display:flex; flex-direction:column; gap:1.25rem;">

      <!-- Investigados -->
      <div>
        <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:0.75rem;">
          <span style="font-size:0.75rem; font-weight:600; color:var(--txt);">Investigados</span>
          <a href="/red" style="font-family:'DM Mono',monospace; font-size:0.6rem; color:var(--txt3); letter-spacing:0.03em;">red →</a>
        </div>
        <div class="ficha">
          {investigated.map((ent, i) => {
            const sc = getStatusColor(ent.status)
            const sl = getStatusLabel(ent.status)
            return (
              <a href={`/personajes/${ent.id}`}
                class="card-hover"
                style={`display:flex; align-items:center; justify-content:space-between; gap:8px; padding:7px 10px; border-bottom:${i < investigated.length-1 ? '1px solid var(--line2)' : 'none'}; text-decoration:none;`}>
                <div style="min-width:0;">
                  <div style="font-size:0.78rem; font-weight:500; color:var(--txt); white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">{ent.name}</div>
                  <div style="font-family:'DM Mono',monospace; font-size:0.58rem; color:var(--txt3); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; margin-top:1px;">{ent.role.slice(0,40)}{ent.role.length>40?'…':''}</div>
                </div>
                <span class="status-pill" style={`background:${sc}15; color:${sc}; border:1px solid ${sc}35; flex-shrink:0;`}>{sl}</span>
              </a>
            )
          })}
        </div>
      </div>

      <!-- Hechos críticos -->
      <div>
        <div style="font-size:0.75rem; font-weight:600; color:var(--txt); margin-bottom:0.75rem;">Hechos críticos</div>
        <div style="display:flex; flex-direction:column; gap:6px;">
          {critical.slice(0,4).map(ev => (
            <a href={`/eventos/${ev.id}`}
              class="card-hover"
              style="display:block; background:var(--card); border:1px solid var(--line); border-left:3px solid var(--red); border-radius:5px; padding:8px 10px; text-decoration:none;">
              <div style="font-family:'DM Mono',monospace; font-size:0.55rem; color:var(--red); text-transform:uppercase; letter-spacing:0.06em; margin-bottom:3px;">
                {formatDate(ev.date, ev.date_precision)}
              </div>
              <div style="font-size:0.75rem; font-weight:500; color:var(--txt); line-height:1.35; letter-spacing:-0.01em;">
                {ev.title}
              </div>
            </a>
          ))}
        </div>
      </div>

    </div>
  </div>
</div>
</Base>
