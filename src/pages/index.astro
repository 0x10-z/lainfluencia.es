---
import Base from '../layouts/Base.astro'

import casesData     from '../data/cases.json'
import eventsData    from '../data/events.json'
import entitiesData  from '../data/entities.json'
import sourcesData   from '../data/sources.json'
import relationsData from '../data/relations.json'

import type { Event, Entity, Source, Case, Relation } from '../types'
import { formatDate, getImpactLabel, getImpactColor, getStatusColor, getStatusLabel } from '../utils'

const events    = eventsData.events    as Event[]
const entities  = entitiesData.entities as Entity[]
const sources   = sourcesData.sources  as Source[]
const cases     = casesData.cases      as Case[]
const relations = relationsData.relations as Relation[]

const caseZ     = cases.find(c => c.id === 'dp-77-24')!
const eventsZ   = events.filter(e => e.cases.includes('dp-77-24'))
const entitiesZ = entities.filter(e => e.cases.includes('dp-77-24'))
const sourcesZ  = sources.filter(s => s.cases.includes('dp-77-24'))

const latest = [...eventsZ]
  .filter(e => !e.pending)
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())
  .slice(0, 8)

const topImpact = eventsZ
  .filter(e => e.impact === 5 && !e.pending)
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())
  .slice(0, 3)

const investigated = entitiesZ
  .filter(e => e.type === 'person' && ['investigated', 'accused', 'convicted'].includes(e.status))

const pending = eventsZ.find(e => e.pending)
---

<Base
  title="La Influencia"
  description="Investigación sobre el Caso Zapatero y Plus Ultra. Datos verificados, fuentes documentadas."
>
  <div style="padding: 2rem 2rem 0;">

    <!-- Cabecera de sección -->
    <div style="margin-bottom: 1.75rem; padding-bottom: 1.25rem; border-bottom: 1px solid var(--line);">
      <div style="font-family:'IBM Plex Mono',monospace; font-size:0.65rem; color:var(--red); text-transform:uppercase; letter-spacing:0.08em; margin-bottom:0.4rem;">
        D.P. 77/2024 — Juzgado Central de Instrucción Nº 2
      </div>
      <h1 style="font-size:1.5rem; font-weight:700; letter-spacing:-0.03em; margin-bottom:0.4rem;">
        Caso Zapatero / Plus Ultra
      </h1>
      <p style="font-size:0.88rem; color:var(--txt2); margin:0; max-width:640px; line-height:1.6;">
        Investigación sobre el presunto rescate irregular de 53 millones de euros
        a la aerolínea venezolana Plus Ultra. El juez Calama imputó a Zapatero el 18 de mayo de 2026
        por organización criminal, tráfico de influencias, blanqueo y falsedad documental.
      </p>
      {pending && (
        <div style="margin-top:0.85rem; display:inline-flex; align-items:center; gap:8px; background:var(--gold-bg); border:1px solid #e0d090; padding:5px 10px; border-radius:4px;">
          <span style="width:6px;height:6px;background:var(--gold);border-radius:50%;display:inline-block;flex-shrink:0;"></span>
          <span style="font-family:'IBM Plex Mono',monospace; font-size:0.62rem; color:var(--gold);">
            Próximo: {pending.title} — {formatDate(pending.date, pending.date_precision)}
          </span>
        </div>
      )}
    </div>

    <!-- Cifras rápidas -->
    <div style="display:grid; grid-template-columns:repeat(4,1fr); gap:1px; background:var(--line); border:1px solid var(--line); margin-bottom:2rem;">
      {[
        { n: eventsZ.length,    label: 'Eventos',     href: '/cronologia' },
        { n: entitiesZ.length,  label: 'Actores',     href: '/red' },
        { n: sourcesZ.length,   label: 'Fuentes',     href: '/documentos' },
        { n: caseZ.charges.length, label: 'Delitos', href: null },
      ].map(s => (
        <div style="background:var(--bg); padding:1rem 1.25rem;">
          {s.href ? (
            <a href={s.href} style="text-decoration:none; display:block;">
              <div style="font-size:1.6rem; font-weight:700; letter-spacing:-0.03em; color:var(--txt); line-height:1;">
                {s.n}
              </div>
              <div style="font-family:'IBM Plex Mono',monospace; font-size:0.6rem; color:var(--txt3); text-transform:uppercase; letter-spacing:0.06em; margin-top:3px;">
                {s.label}
              </div>
            </a>
          ) : (
            <>
              <div style="font-size:1.6rem; font-weight:700; letter-spacing:-0.03em; color:var(--txt); line-height:1;">
                {s.n}
              </div>
              <div style="font-family:'IBM Plex Mono',monospace; font-size:0.6rem; color:var(--txt3); text-transform:uppercase; letter-spacing:0.06em; margin-top:3px;">
                {s.label}
              </div>
            </>
          )}
        </div>
      ))}
    </div>

    <!-- Dos columnas: eventos + personas -->
    <div style="display:grid; grid-template-columns:1fr 260px; gap:2rem; align-items:start;">

      <!-- Columna izquierda: últimos eventos -->
      <div>
        <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:1rem;">
          <span style="font-size:0.75rem; font-weight:600; color:var(--txt);">Últimos eventos</span>
          <a href="/cronologia" style="font-family:'IBM Plex Mono',monospace; font-size:0.62rem; color:var(--txt3); text-decoration:none; letter-spacing:0.03em;">
            Ver todos →
          </a>
        </div>

        <div style="display:flex; flex-direction:column; border:1px solid var(--line);">
          {latest.map((ev, i) => {
            const impactColor = getImpactColor(ev.impact)
            const borderColor = ev.cases.includes('dp-77-24') && ev.cases.includes('caso-koldo')
              ? 'var(--gold)' : 'var(--red)'
            return (
              <a
                href={`/eventos/${ev.id}`}
                style={`
                  display:block; padding:0.85rem 1rem;
                  border-bottom:${i < latest.length - 1 ? '1px solid var(--line)' : 'none'};
                  border-left:3px solid ${borderColor};
                  text-decoration:none;
                  transition:background 0.1s;
                `}
                class="card-hover"
              >
                <div style="display:flex; align-items:center; gap:8px; margin-bottom:4px;">
                  <time style="font-family:'IBM Plex Mono',monospace; font-size:0.6rem; color:var(--txt3); letter-spacing:0.03em; white-space:nowrap;">
                    {formatDate(ev.date, ev.date_precision)}
                  </time>
                  <span style={`font-family:'IBM Plex Mono',monospace; font-size:0.58rem; color:${impactColor}; text-transform:uppercase; letter-spacing:0.06em;`}>
                    {getImpactLabel(ev.impact)}
                  </span>
                </div>
                <div style="font-size:0.85rem; font-weight:600; color:var(--txt); line-height:1.35; letter-spacing:-0.01em;">
                  {ev.title}
                </div>
              </a>
            )
          })}
        </div>
      </div>

      <!-- Columna derecha: personas -->
      <div>
        <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:1rem;">
          <span style="font-size:0.75rem; font-weight:600; color:var(--txt);">Personas investigadas</span>
          <a href="/red" style="font-family:'IBM Plex Mono',monospace; font-size:0.62rem; color:var(--txt3); text-decoration:none; letter-spacing:0.03em;">
            Red →
          </a>
        </div>

        <div style="display:flex; flex-direction:column; border:1px solid var(--line);">
          {investigated.map((ent, i) => {
            const sc = getStatusColor(ent.status)
            const sl = getStatusLabel(ent.status)
            return (
              <a
                href={`/personajes/${ent.id}`}
                style={`
                  display:flex; align-items:center; gap:10px;
                  padding:0.7rem 1rem;
                  border-bottom:${i < investigated.length - 1 ? '1px solid var(--line)' : 'none'};
                  text-decoration:none;
                  transition:background 0.1s;
                `}
                class="card-hover"
              >
                <div style="flex:1; min-width:0;">
                  <div style="font-size:0.82rem; font-weight:600; color:var(--txt); line-height:1.3; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                    {ent.name}
                  </div>
                  <div style="font-size:0.72rem; color:var(--txt2); line-height:1.3; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                    {ent.role}
                  </div>
                </div>
                <span class="status-pill" style={`background:${sc}18; color:${sc}; border:1px solid ${sc}40; flex-shrink:0;`}>
                  {sl}
                </span>
              </a>
            )
          })}
        </div>

        <!-- Eventos críticos -->
        <div style="margin-top:1.5rem;">
          <div style="font-size:0.75rem; font-weight:600; color:var(--txt); margin-bottom:1rem;">
            Hechos críticos
          </div>
          <div style="display:flex; flex-direction:column; gap:8px;">
            {topImpact.map(ev => (
              <a
                href={`/eventos/${ev.id}`}
                style="display:block; padding:0.75rem; background:var(--red-bg); border:1px solid #f0c4c0; border-left:3px solid var(--red); text-decoration:none;"
                class="card-hover"
              >
                <div style="font-family:'IBM Plex Mono',monospace; font-size:0.58rem; color:var(--red); text-transform:uppercase; letter-spacing:0.06em; margin-bottom:3px;">
                  {formatDate(ev.date, ev.date_precision)}
                </div>
                <div style="font-size:0.78rem; font-weight:600; color:var(--txt); line-height:1.35; letter-spacing:-0.01em;">
                  {ev.title}
                </div>
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</Base>
