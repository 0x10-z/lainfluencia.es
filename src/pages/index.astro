---
import Base from '../layouts/Base.astro'
import type { Event, Entity, Case } from '../types'
import { formatDate } from '../utils'

import casesData    from '../data/cases.json'
import eventsData   from '../data/events.json'
import entitiesData from '../data/entities.json'

const caseZ     = (casesData.cases as Case[]).find(c => c.id === 'dp-77-24')!
const allEvents = eventsData.events as Event[]
const entities  = entitiesData.entities as Entity[]

const eventsZ   = allEvents.filter(e => e.cases.includes('dp-77-24'))
const entitiesZ = entities.filter(e => e.cases.includes('dp-77-24'))

const critical = allEvents.filter(e => e.impact === 5 && !e.pending && e.cases.includes('dp-77-24'))

const pending = eventsZ.find(e => e.pending)
---

<Base title="La Influencia" description="Investigación sobre el Caso Zapatero. Datos verificados, fuentes documentadas.">

  <!-- ── PORTADA CINÉMATICA ─────────────────────────── -->
  <section style="
    min-height: 80vh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 0 3vw 3rem;
    position: relative;
    border-bottom: 1px solid var(--line);
    overflow: hidden;
  ">
    <!-- Fondo tipográfico decorativo -->
    <div aria-hidden="true" style="
      position: absolute; top: -2rem; left: -1rem;
      font-family: var(--ft); font-size: clamp(8rem, 22vw, 22rem);
      font-weight: 900; font-style: italic; color: var(--txt);
      opacity: 0.018; letter-spacing: -0.04em; line-height: 0.85;
      pointer-events: none; user-select: none; white-space: nowrap;
    ">Corrupción</div>

    <!-- Expediente badge -->
    <div class="fade-up" style="display:flex;align-items:center;gap:0.6rem;margin-bottom:1.5rem;">
      <span style="
        font-family:var(--fm);font-size:0.5rem;letter-spacing:0.2em;text-transform:uppercase;
        color:var(--red);border:1px solid var(--red2);padding:0.15rem 0.55rem;border-radius:999px;
      ">D.P. 77/2024</span>
      <span style="font-family:var(--fm);font-size:0.5rem;letter-spacing:0.15em;text-transform:uppercase;color:var(--txt3);">
        Juzgado Central de Instrucción Nº 2 · Madrid
      </span>
    </div>

    <!-- Titular -->
    <h1 class="fade-up" style="
      font-family:var(--ft);font-size:clamp(2.8rem,7vw,5.5rem);font-weight:900;
      line-height:1.0;letter-spacing:-0.025em;color:var(--txt);margin-bottom:1rem;max-width:820px;
    ">
      Caso Zapatero<br>
      <em style="color:var(--red);font-style:italic;">Plus Ultra</em>
    </h1>

    <!-- Subtítulo -->
    <p class="fade-up" style="
      font-family:var(--fb);font-size:0.9rem;color:var(--txt2);
      max-width:580px;line-height:1.65;margin-bottom:2rem;
    ">
      Investigación sobre el rescate de 53&nbsp;M€ a una aerolínea venezolana.
      El juez Calama imputó al expresidente Zapatero el 18&nbsp;may.&nbsp;2026
      por cuatro delitos. Primera imputación formal de un expresidente de España.
    </p>

    <!-- Métricas -->
    <div class="fade-up" style="
      display:flex;flex-wrap:wrap;gap:0;
      border:1px solid var(--line);border-radius:12px;width:fit-content;overflow:hidden;
    ">
      {[
        { n: eventsZ.length,   label:'Eventos',    href:'/cronologia' },
        { n: entitiesZ.length, label:'Actores',    href:'/personajes' },
        { n: critical.length,  label:'Críticos',   href:'/cronologia' },
        { n: '53M€',           label:'Fondos',     href:'/documentos' },
      ].map(({ n, label, href }, i, arr) => (
        <a href={href} class="metric-link" style={`
          display:block;padding:1.2rem 2rem;
          border-right:${i < arr.length-1 ? '1px solid var(--line)' : 'none'};
          text-decoration:none;min-width:110px;
        `}>
          <div style="font-family:var(--ft);font-size:2.2rem;font-weight:900;color:var(--txt);line-height:1;margin-bottom:0.3rem;">{n}</div>
          <div style="font-family:var(--fm);font-size:0.5rem;letter-spacing:0.12em;text-transform:uppercase;color:var(--txt3);">{label}</div>
        </a>
      ))}
    </div>

    {pending && (
      <div class="fade-up" style="
        position:absolute;top:2rem;right:3vw;
        border:1px solid var(--gold);border-radius:10px;
        padding:0.8rem 1rem;max-width:260px;
        background:rgba(107,80,6,0.05);
      ">
        <div style="font-family:var(--fm);font-size:0.45rem;letter-spacing:0.18em;text-transform:uppercase;color:var(--gold);margin-bottom:0.4rem;">
          Próximo · Pendiente
        </div>
        <div style="font-family:var(--ft);font-size:0.88rem;font-weight:700;color:var(--txt);line-height:1.25;margin-bottom:0.3rem;">
          {pending.title}
        </div>
        <div style="font-family:var(--fm);font-size:0.55rem;color:var(--txt3);">
          {formatDate(pending.date, pending.date_precision)}
        </div>
      </div>
    )}
  </section>

  <!-- ── EXPEDIENTE FICHA ────────────────────────────── -->
  <section style="border-bottom:1px solid var(--line);">
    <div style="display:grid;grid-template-columns:1fr 1fr;border-bottom:1px solid var(--line);">
      <div style="padding:2rem 3vw;border-right:1px solid var(--line);">
        <div style="font-family:var(--fm);font-size:0.5rem;letter-spacing:0.18em;text-transform:uppercase;color:var(--txt3);margin-bottom:1rem;">
          Ficha del expediente
        </div>
        <div class="ficha">
          {[
            { k: 'N.º diligencias',  v: 'D.P. 77/2024' },
            { k: 'Juzgado',          v: 'Central de Instrucción Nº 2 · Madrid' },
            { k: 'Juez instructor',  v: 'José Luis Calama' },
            { k: 'Fase procesal',    v: 'Instrucción' },
            { k: 'Auto imputación',  v: '18 de mayo de 2026 · 88 páginas' },
          ].map(({ k, v }) => (
            <div class="ficha-row">
              <div class="ficha-label">{k}</div>
              <div class="ficha-value">{v}</div>
            </div>
          ))}
        </div>
      </div>

      <div style="padding:2rem 3vw;">
        <div style="font-family:var(--fm);font-size:0.5rem;letter-spacing:0.18em;text-transform:uppercase;color:var(--txt3);margin-bottom:1rem;">
          Delitos imputados
        </div>
        <ul style="list-style:none;display:flex;flex-direction:column;gap:0.4rem;">
          {caseZ.charges.map(charge => (
            <li style="display:flex;gap:0.6rem;align-items:flex-start;padding:0.5rem 0;border-bottom:1px solid var(--line);">
              <span style="font-family:var(--fm);font-size:0.5rem;color:var(--red);flex-shrink:0;margin-top:2px;">▸</span>
              <span style="font-family:var(--fb);font-size:0.82rem;color:var(--txt2);line-height:1.4;">{charge}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Disclaimer -->
  <section style="padding:1.5rem 3vw;">
    <p style="font-family:var(--fm);font-size:0.52rem;color:var(--txt3);letter-spacing:0.05em;line-height:1.8;max-width:680px;">
      La imputación o procesamiento judicial no implica condena. Inocentes hasta sentencia firme.
      Fuentes documentadas · Datos auditables y públicos.
    </p>
  </section>

</Base>

<style>
  .metric-link { transition: background 0.15s; }
  .metric-link:hover { background: var(--bg2); }
</style>
