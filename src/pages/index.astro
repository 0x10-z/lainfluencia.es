---
import Base from '../layouts/Base.astro'
import type { Event, Entity, Source, Case } from '../types'
import { formatDate, getImpactColor, getImpactLabel, getStatusColor, getStatusLabel } from '../utils'

import casesData    from '../data/cases.json'
import eventsData   from '../data/events.json'
import entitiesData from '../data/entities.json'
import sourcesData  from '../data/sources.json'

const caseZ     = (casesData.cases as Case[]).find(c => c.id === 'dp-77-24')!
const allEvents = eventsData.events as Event[]
const entities  = entitiesData.entities as Entity[]
const sources   = sourcesData.sources as Source[]

const eventsZ   = allEvents.filter(e => e.cases.includes('dp-77-24'))
const eventsK   = allEvents.filter(e => e.cases.includes('caso-koldo'))
const entitiesZ = entities.filter(e => e.cases.includes('dp-77-24'))

const latest = [...eventsZ]
  .filter(e => !e.pending)
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())
  .slice(0, 8)

const critical = allEvents.filter(e => e.impact === 5 && !e.pending)
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())

const investigated = entitiesZ
  .filter(e => e.type === 'person' && ['investigated','accused','convicted'].includes(e.status))

const pending = eventsZ.find(e => e.pending)
---

<Base title="La Influencia" description="Investigación sobre el Caso Zapatero. Datos verificados, fuentes documentadas.">

  <!-- ── PORTADA CINÉMATICA ──────────────────────────────── -->
  <section style="
    min-height: 80vh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 0 3vw 3rem;
    position: relative;
    border-bottom: 1px solid var(--line);
    overflow: hidden;
  ">
    <!-- Fondo tipográfico decorativo -->
    <div aria-hidden="true" style="
      position: absolute;
      top: -2rem;
      left: -1rem;
      font-family: var(--ft);
      font-size: clamp(8rem, 22vw, 22rem);
      font-weight: 900;
      font-style: italic;
      color: var(--txt);
      opacity: 0.018;
      letter-spacing: -0.04em;
      line-height: 0.85;
      pointer-events: none;
      user-select: none;
      white-space: nowrap;
    ">
      Corrupción
    </div>

    <!-- Expediente badge -->
    <div class="fade-up" style="
      display: flex;
      align-items: center;
      gap: 0.6rem;
      margin-bottom: 1.5rem;
    ">
      <span style="
        font-family: var(--fm);
        font-size: 0.5rem;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--red);
        border: 1px solid var(--red2);
        padding: 0.15rem 0.5rem;
      ">D.P. 77/2024</span>
      <span style="
        font-family: var(--fm);
        font-size: 0.5rem;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: var(--txt3);
      ">Juzgado Central de Instrucción Nº 2 · Madrid</span>
    </div>

    <!-- Titular principal -->
    <h1 class="fade-up" style="
      font-family: var(--ft);
      font-size: clamp(2.8rem, 7vw, 5.5rem);
      font-weight: 900;
      line-height: 1.0;
      letter-spacing: -0.025em;
      color: var(--txt);
      margin-bottom: 1rem;
      max-width: 820px;
    ">
      Caso Zapatero<br>
      <em style="color: var(--red); font-style: italic;">Plus Ultra</em>
    </h1>

    <!-- Subtítulo -->
    <p class="fade-up" style="
      font-family: var(--fb);
      font-size: 0.9rem;
      color: var(--txt2);
      max-width: 580px;
      line-height: 1.65;
      margin-bottom: 2rem;
    ">
      Investigación sobre el rescate de 53&nbsp;M€ a una aerolínea venezolana.
      El juez Calama imputó al expresidente Zapatero el 18&nbsp;may.&nbsp;2026
      por cuatro delitos. Primera imputación formal de un expresidente de España.
    </p>

    <!-- Métricas -->
    <div class="fade-up" style="
      display: flex;
      flex-wrap: wrap;
      gap: 0;
      border: 1px solid var(--line);
      width: fit-content;
    ">
      {[
        { n: eventsZ.length,    label:'Eventos documentados',   href:'/cronologia' },
        { n: entitiesZ.length,  label:'Actores identificados',  href:'/personajes' },
        { n: critical.filter(e => e.cases.includes('dp-77-24')).length, label:'Hechos críticos', href:'/cronologia' },
        { n: '53M',             label:'€ en fondos públicos',   href:'/documentos' },
      ].map(({ n, label, href }, i, arr) => (
        <a href={href} style={`
          display: block;
          padding: 1.2rem 2rem;
          border-right: ${i < arr.length-1 ? '1px solid var(--line)' : 'none'};
          text-decoration: none;
          transition: background 0.15s;
          min-width: 130px;
        `}
        onmouseover="this.style.background='var(--bg2)'"
        onmouseout="this.style.background=''"
        >
          <div style="
            font-family: var(--ft);
            font-size: 2.2rem;
            font-weight: 900;
            color: var(--txt);
            line-height: 1;
            margin-bottom: 0.3rem;
          ">{n}</div>
          <div style="
            font-family: var(--fm);
            font-size: 0.5rem;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            color: var(--txt3);
          ">{label}</div>
        </a>
      ))}
    </div>

    {pending && (
      <div class="fade-up" style="
        position: absolute;
        top: 2rem;
        right: 3vw;
        border: 1px solid var(--gold);
        padding: 0.7rem 1rem;
        max-width: 280px;
        background: rgba(184,150,12,0.05);
      ">
        <div style="font-family:var(--fm);font-size:0.45rem;letter-spacing:0.18em;text-transform:uppercase;color:var(--gold);margin-bottom:0.4rem;">
          Próximo · Pendiente
        </div>
        <div style="font-family:var(--ft);font-size:0.9rem;font-weight:700;color:var(--txt);line-height:1.25;margin-bottom:0.3rem;">
          {pending.title}
        </div>
        <div style="font-family:var(--fm);font-size:0.55rem;color:var(--txt3);">
          {formatDate(pending.date, pending.date_precision)}
        </div>
      </div>
    )}
  </section>

  <!-- ── EXPEDIENTE FICHA ─────────────────────────────────── -->
  <section style="border-bottom: 1px solid var(--line);">
    <div style="display:grid; grid-template-columns: 1fr 1fr; border-bottom: 1px solid var(--line);">
      {/* Datos del caso */}
      <div style="padding: 2rem 3vw; border-right: 1px solid var(--line);">
        <div style="font-family:var(--fm);font-size:0.5rem;letter-spacing:0.18em;text-transform:uppercase;color:var(--txt3);margin-bottom:1.2rem;">
          Ficha del expediente
        </div>
        <div class="ficha">
          {[
            { k: 'N.º diligencias',  v: 'D.P. 77/2024' },
            { k: 'Juzgado',          v: 'Central de Instrucción Nº 2 · Madrid' },
            { k: 'Juez instructor',  v: 'José Luis Calama' },
            { k: 'Fase procesal',    v: 'Instrucción' },
            { k: 'Auto imputación',  v: '18 de mayo de 2026 · 88 páginas' },
          ].map(({ k, v }) => (
            <div class="ficha-row">
              <div class="ficha-label">{k}</div>
              <div class="ficha-value">{v}</div>
            </div>
          ))}
        </div>
      </div>

      {/* Cargos */}
      <div style="padding: 2rem 3vw;">
        <div style="font-family:var(--fm);font-size:0.5rem;letter-spacing:0.18em;text-transform:uppercase;color:var(--txt3);margin-bottom:1.2rem;">
          Delitos imputados
        </div>
        <ul style="list-style:none; display:flex; flex-direction:column; gap:0.5rem;">
          {caseZ.charges.map(charge => (
            <li style="display:flex; gap:0.8rem; align-items:flex-start; padding:0.6rem 0; border-bottom:1px solid var(--line);">
              <span style="font-family:var(--fm);font-size:0.5rem;color:var(--red);flex-shrink:0;margin-top:2px;letter-spacing:0.1em;">▸</span>
              <span style="font-family:var(--fb);font-size:0.82rem;color:var(--txt2);line-height:1.4;">{charge}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ── CUERPO: EVENTOS + ACTORES ──────────────────────── -->
  <section style="display:grid; grid-template-columns:1fr 320px; border-bottom: 1px solid var(--line);">

    <!-- Columna principal: eventos recientes -->
    <div style="border-right: 1px solid var(--line);">
      <div style="
        padding: 1rem 3vw;
        border-bottom: 1px solid var(--line);
        display: flex;
        align-items: baseline;
        justify-content: space-between;
      ">
        <span style="font-family:var(--fm);font-size:0.5rem;letter-spacing:0.18em;text-transform:uppercase;color:var(--txt3);">
          Últimos eventos documentados
        </span>
        <a href="/cronologia" style="font-family:var(--fm);font-size:0.5rem;letter-spacing:0.1em;color:var(--txt3);text-transform:uppercase;">
          Ver cronología completa →
        </a>
      </div>

      {latest.map((ev, i) => {
        const ic = getImpactColor(ev.impact)
        const isCritical = ev.impact >= 4
        return (
          <a href={`/eventos/${ev.id}`}
            class="fade-up card-hover"
            style={`
              display: grid;
              grid-template-columns: 80px 1fr;
              border-bottom: 1px solid var(--line);
              text-decoration: none;
              border-left: 2px solid ${isCritical ? 'var(--red)' : 'var(--line2)'};
              transition: background 0.15s;
            `}>
            <div style="
              padding: 1.2rem 1rem;
              border-right: 1px solid var(--line);
              background: var(--bg2);
              display: flex;
              flex-direction: column;
              justify-content: center;
              gap: 4px;
            ">
              <time style="font-family:var(--fm);font-size:0.58rem;color:var(--txt3);letter-spacing:0.04em;line-height:1.5;display:block;">
                {formatDate(ev.date, ev.date_precision)}
              </time>
              <div style={`display:flex;gap:2px;`}>
                {[1,2,3,4,5].map(n => (
                  <span style={`width:10px;height:2px;background:${n<=ev.impact ? ic : 'var(--line2)'};display:block;`} />
                ))}
              </div>
            </div>
            <div style="padding: 1.2rem 1.5rem; display:flex; align-items:center;">
              <span style="font-family:var(--ft);font-size:0.92rem;font-weight:700;color:var(--txt);line-height:1.3;">
                {ev.title}
              </span>
            </div>
          </a>
        )
      })}
    </div>

    <!-- Columna lateral -->
    <div>
      {/* Investigados */}
      <div style="border-bottom: 1px solid var(--line);">
        <div style="padding:1rem 1.5rem;border-bottom:1px solid var(--line);">
          <span style="font-family:var(--fm);font-size:0.5rem;letter-spacing:0.18em;text-transform:uppercase;color:var(--txt3);">
            Actores investigados
          </span>
        </div>
        {investigated.map((ent, i) => {
          const sc = getStatusColor(ent.status)
          const sl = getStatusLabel(ent.status)
          return (
            <a href={`/personajes/${ent.id}`}
              class="card-hover"
              style={`
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 8px;
                padding: 0.85rem 1.5rem;
                border-bottom: ${i < investigated.length-1 ? '1px solid var(--line)' : 'none'};
                text-decoration: none;
              `}>
              <div style="min-width:0;">
                <div style="font-family:var(--ft);font-size:0.85rem;font-weight:700;color:var(--txt);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                  {ent.name}
                </div>
                <div style="font-family:var(--fm);font-size:0.52rem;color:var(--txt3);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-top:2px;letter-spacing:0.04em;">
                  {ent.role.slice(0,42)}{ent.role.length>42?'…':''}
                </div>
              </div>
              <span class="status-pill" style={`border-color:${sc};color:${sc};flex-shrink:0;`}>{sl}</span>
            </a>
          )
        })}
      </div>

      {/* Hechos críticos */}
      <div>
        <div style="padding:1rem 1.5rem;border-bottom:1px solid var(--line);">
          <span style="font-family:var(--fm);font-size:0.5rem;letter-spacing:0.18em;text-transform:uppercase;color:var(--txt3);">
            Hechos de máximo impacto
          </span>
        </div>
        {critical.filter(e => e.cases.includes('dp-77-24')).slice(0, 5).map((ev, i, arr) => (
          <a href={`/eventos/${ev.id}`}
            class="card-hover"
            style={`
              display: block;
              padding: 0.9rem 1.5rem;
              border-bottom: ${i < arr.length-1 ? '1px solid var(--line)' : 'none'};
              text-decoration: none;
              border-left: 2px solid var(--red);
            `}>
            <div style="font-family:var(--fm);font-size:0.48rem;color:var(--red);text-transform:uppercase;letter-spacing:0.12em;margin-bottom:0.35rem;">
              {formatDate(ev.date, ev.date_precision)}
            </div>
            <div style="font-family:var(--ft);font-size:0.82rem;font-weight:700;color:var(--txt);line-height:1.3;">
              {ev.title}
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ── DISCLAIMER EDITORIAL ───────────────────────────── -->
  <section style="padding:2rem 3vw;">
    <p style="font-family:var(--fm);font-size:0.52rem;color:var(--txt3);letter-spacing:0.06em;line-height:1.8;max-width:700px;">
      La imputación o procesamiento judicial no implica condena penal. Todas las personas mencionadas
      son inocentes hasta que exista sentencia judicial firme. Los datos son públicos y están
      respaldados por fuentes documentadas en cada hecho.
    </p>
  </section>

</Base>
