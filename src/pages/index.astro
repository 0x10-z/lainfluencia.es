---
import Base from '../layouts/Base.astro'
import type { Event, Entity, Case } from '../types'
import { formatDate } from '../utils'

import casesData    from '../data/cases.json'
import eventsData   from '../data/events.json'
import entitiesData from '../data/entities.json'

const caseZ     = (casesData.cases as Case[]).find(c => c.id === 'dp-77-24')!
const allEvents = eventsData.events as Event[]
const entities  = entitiesData.entities as Entity[]

const eventsZ   = allEvents.filter(e => e.cases.includes('dp-77-24'))
const entitiesZ = entities.filter(e => e.cases.includes('dp-77-24'))

const critical = allEvents.filter(e => e.impact === 5 && !e.pending && e.cases.includes('dp-77-24'))

const pending = eventsZ.find(e => e.pending)
---

<Base title="La Influencia" description="Investigación sobre el Caso Zapatero. Datos verificados, fuentes documentadas.">

  <!-- ── PORTADA ─────────────────────────── -->
  <section class="hero">
    <!-- Fondo tipográfico decorativo -->
    <div aria-hidden="true" class="hero-bg">Corrupción</div>

    <!-- Expediente badge -->
    <div class="fade-up hero-badge">
      <span class="badge-exp">D.P. 77/2024</span>
      <span class="badge-juzgado">Juzgado Central de Instrucción Nº 2 · Madrid</span>
    </div>

    <!-- Titular -->
    <h1 class="fade-up hero-title">
      Caso Zapatero<br>
      <em>Plus Ultra</em>
    </h1>

    <!-- Subtítulo -->
    <p class="fade-up hero-sub">
      Investigación sobre el rescate de 53&nbsp;M€ a una aerolínea venezolana.
      El juez Calama imputó al expresidente Zapatero el 18&nbsp;may.&nbsp;2026
      por cuatro delitos. Primera imputación formal de un expresidente de España.
    </p>

    <!-- Métricas -->
    <div class="fade-up metrics">
      {[
        { n: eventsZ.length,   label:'Eventos',    href:'/cronologia' },
        { n: entitiesZ.length, label:'Actores',    href:'/personajes' },
        { n: critical.length,  label:'Críticos',   href:'/cronologia' },
        { n: '53M€',           label:'Fondos',     href:'/documentos' },
      ].map(({ n, label, href }, i, arr) => (
        <a href={href} class="metric-link" style={`border-right:${i < arr.length-1 ? '1px solid var(--line)' : 'none'}`}>
          <div class="metric-n">{n}</div>
          <div class="metric-label">{label}</div>
        </a>
      ))}
    </div>

    {pending && (
      <div class="fade-up pending-box">
        <div class="pending-label">Próximo · Pendiente</div>
        <div class="pending-title">{pending.title}</div>
        <div class="pending-date">{formatDate(pending.date, pending.date_precision)}</div>
      </div>
    )}
  </section>

  <!-- ── EXPEDIENTE FICHA ────────────────────────────── -->
  <section class="ficha-section">
    <div class="ficha-grid">
      <div class="ficha-col">
        <div class="col-label">Ficha del expediente</div>
        <div class="ficha">
          {[
            { k: 'N.º diligencias',  v: 'D.P. 77/2024' },
            { k: 'Juzgado',          v: 'Central de Instrucción Nº 2 · Madrid' },
            { k: 'Juez instructor',  v: 'José Luis Calama' },
            { k: 'Fase procesal',    v: 'Instrucción' },
            { k: 'Auto imputación',  v: '18 de mayo de 2026 · 88 páginas' },
          ].map(({ k, v }) => (
            <div class="ficha-row">
              <div class="ficha-label">{k}</div>
              <div class="ficha-value">{v}</div>
            </div>
          ))}
        </div>
      </div>

      <div class="ficha-col">
        <div class="col-label">Delitos imputados</div>
        <ul class="charges">
          {caseZ.charges.map(charge => (
            <li class="charge-item">
              <span class="charge-arrow">▸</span>
              <span class="charge-text">{charge}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

</Base>

<style>
  /* ── HERO ── */
  .hero {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 2.5rem 3vw 2rem;
    position: relative;
    border-bottom: 1px solid var(--line);
    overflow: hidden;
  }

  .hero-bg {
    position: absolute; top: -2rem; left: -1rem;
    font-family: var(--ft); font-size: clamp(8rem, 22vw, 22rem);
    font-weight: 900; font-style: italic; color: var(--txt);
    opacity: 0.018; letter-spacing: -0.04em; line-height: 0.85;
    pointer-events: none; user-select: none; white-space: nowrap;
  }

  .hero-badge {
    display: flex; align-items: center; flex-wrap: wrap;
    gap: 0.5rem; margin-bottom: 0.9rem;
  }

  .badge-exp {
    font-family: var(--fm); font-size: 0.5rem; letter-spacing: 0.2em;
    text-transform: uppercase; color: var(--red);
    border: 1px solid var(--red2); padding: 0.15rem 0.55rem; border-radius: 999px;
  }

  .badge-juzgado {
    font-family: var(--fm); font-size: 0.5rem; letter-spacing: 0.15em;
    text-transform: uppercase; color: var(--txt3);
  }

  .hero-title {
    font-family: var(--ft); font-size: clamp(2.2rem, 5vw, 4rem); font-weight: 900;
    line-height: 1.0; letter-spacing: -0.025em; color: var(--txt);
    margin-bottom: 0.7rem; max-width: 820px;
  }

  .hero-title em { color: var(--red); font-style: italic; }

  .hero-sub {
    font-family: var(--fb); font-size: 0.85rem; color: var(--txt2);
    max-width: 580px; line-height: 1.55; margin-bottom: 1.25rem;
  }

  /* ── MÉTRICAS ── */
  .metrics {
    display: flex; flex-wrap: wrap; gap: 0;
    border: 1px solid var(--line); border-radius: 12px;
    width: fit-content; overflow: hidden;
  }

  .metric-link {
    display: block; padding: 0.9rem 1.5rem;
    text-decoration: none; min-width: 100px;
    transition: background 0.15s;
  }
  .metric-link:hover { background: var(--bg2); }

  .metric-n {
    font-family: var(--ft); font-size: 1.8rem; font-weight: 900;
    color: var(--txt); line-height: 1; margin-bottom: 0.2rem;
  }

  .metric-label {
    font-family: var(--fm); font-size: 0.5rem;
    letter-spacing: 0.12em; text-transform: uppercase; color: var(--txt3);
  }

  /* ── PENDING ── */
  .pending-box {
    position: absolute; top: 2rem; right: 3vw;
    border: 1px solid var(--gold); border-radius: 10px;
    padding: 0.8rem 1rem; max-width: 260px;
    background: rgba(107,80,6,0.05);
  }

  .pending-label {
    font-family: var(--fm); font-size: 0.45rem; letter-spacing: 0.18em;
    text-transform: uppercase; color: var(--gold); margin-bottom: 0.4rem;
  }

  .pending-title {
    font-family: var(--ft); font-size: 0.88rem; font-weight: 700;
    color: var(--txt); line-height: 1.25; margin-bottom: 0.3rem;
  }

  .pending-date {
    font-family: var(--fm); font-size: 0.55rem; color: var(--txt3);
  }

  /* ── FICHA SECTION ── */
  .ficha-section { border-bottom: 1px solid var(--line); }

  .ficha-grid {
    display: grid; grid-template-columns: 1fr 1fr;
    border-bottom: 1px solid var(--line);
  }

  .ficha-col { padding: 1.25rem 3vw; }
  .ficha-col:first-child { border-right: 1px solid var(--line); }

  .col-label {
    font-family: var(--fm); font-size: 0.5rem; letter-spacing: 0.18em;
    text-transform: uppercase; color: var(--txt3); margin-bottom: 0.6rem;
  }

  /* ── DELITOS ── */
  .charges { list-style: none; display: flex; flex-direction: column; gap: 0; }

  .charge-item {
    display: flex; gap: 0.6rem; align-items: flex-start;
    padding: 0.35rem 0; border-bottom: 1px solid var(--line);
  }

  .charge-arrow {
    font-family: var(--fm); font-size: 0.5rem;
    color: var(--red); flex-shrink: 0; margin-top: 2px;
  }

  .charge-text {
    font-family: var(--fb); font-size: 0.78rem;
    color: var(--txt2); line-height: 1.35;
  }

  /* ── RESPONSIVE MÓVIL ── */
  @media (max-width: 640px) {
    .hero { padding: 1.5rem 5vw 1.5rem; }

    .hero-bg { font-size: clamp(5rem, 40vw, 10rem); top: -1rem; }

    .badge-juzgado { display: none; }

    .hero-title { font-size: clamp(2rem, 9vw, 3rem); margin-bottom: 0.6rem; }

    .hero-sub { font-size: 0.8rem; margin-bottom: 1rem; }

    .metrics { width: 100%; }

    .metric-link {
      min-width: 0;
      flex: 1;
      padding: 0.75rem 0.75rem;
      text-align: center;
    }

    .metric-n { font-size: 1.4rem; }

    .pending-box {
      position: static;
      margin-top: 1rem;
      max-width: 100%;
    }

    .ficha-grid { grid-template-columns: 1fr; }

    .ficha-col:first-child {
      border-right: none;
      border-bottom: 1px solid var(--line);
    }
  }
</style>
