---
import Base from '../layouts/Base.astro'
import CronologiaClient from '../components/CronologiaClient.tsx'

import eventsData   from '../data/events.json'
import entitiesData from '../data/entities.json'
import sourcesData  from '../data/sources.json'

import type { Event, Entity, Source } from '../types'

const events   = (eventsData.events as Event[]).sort(
  (a, b) => new Date(a.date).getTime() - new Date(b.date).getTime()
)
const entities = entitiesData.entities as Entity[]
const sources  = sourcesData.sources as Source[]
const tipos    = [...new Set(events.map(e => e.type))]
---

<Base
  title="Cronología"
  description="Todos los hechos documentados del Caso Zapatero, ordenados cronológicamente."
>
  <div style="padding:2rem 2rem 0; border-bottom:1px solid var(--line); margin-bottom:0;">
    <div style="font-family:'IBM Plex Mono',monospace; font-size:0.65rem; color:var(--txt3); text-transform:uppercase; letter-spacing:0.08em; margin-bottom:0.3rem;">
      Cronología
    </div>
    <h1 style="font-size:1.35rem; font-weight:700; letter-spacing:-0.02em; margin-bottom:0.3rem;">
      {events.length} hechos documentados
    </h1>
    <p style="font-size:0.82rem; color:var(--txt2); margin:0 0 1.25rem;">
      Ordenados cronológicamente · Fuentes verificadas en cada evento
    </p>
  </div>

  <div style="padding:0 2rem 3rem;">
    <CronologiaClient
      events={events}
      entities={entities}
      sources={sources}
      tipos={tipos}
      client:load
    />
  </div>
</Base>
