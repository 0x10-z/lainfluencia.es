---
import Base from '../layouts/Base.astro'
import CronologiaClient from '../components/CronologiaClient.tsx'

import eventsData from '../data/events.json'
import type { Event } from '../types'

const events = (eventsData.events as Event[]).sort(
  (a, b) => new Date(a.date).getTime() - new Date(b.date).getTime()
)
const tipos = [...new Set(events.map(e => e.type))]
---

<Base
  title="Cronología"
  description="Todos los hechos documentados del Caso Zapatero, ordenados cronológicamente."
>
  <!-- Cabecera de sección -->
  <div style="padding:2rem 3vw 1.5rem; border-bottom:1px solid var(--line);">
    <div style="font-family:var(--fm); font-size:0.5rem; color:var(--txt3); text-transform:uppercase; letter-spacing:0.18em; margin-bottom:0.5rem;">
      Cronología · Archivo de hechos
    </div>
    <h1 style="font-family:var(--ft); font-size:clamp(1.8rem,4vw,2.8rem); font-weight:900; letter-spacing:-0.025em; margin-bottom:0.4rem; line-height:1.05;">
      {events.length} hechos documentados
    </h1>
    <p style="font-family:var(--fb); font-size:0.85rem; color:var(--txt2); margin:0; max-width:520px; line-height:1.6;">
      Pulsa cualquier hecho para abrir su ficha completa. Fuentes verificadas en cada evento.
    </p>
  </div>

  <CronologiaClient events={events} tipos={tipos} client:load />
</Base>
