---
import Base from '../layouts/Base.astro'
import EventCard from '../components/EventCard.astro'
import CronologiaClient from '../components/CronologiaClient.tsx'

import eventsData from '../data/events.json'
import entitiesData from '../data/entities.json'
import sourcesData from '../data/sources.json'

import type { Event, Entity, Source } from '../types'

const events = (eventsData.events as Event[]).sort(
  (a, b) => new Date(a.date).getTime() - new Date(b.date).getTime()
)
const entities = entitiesData.entities as Entity[]
const sources = sourcesData.sources as Source[]

const tipos = [...new Set(events.map(e => e.type))]
---

<Base
  title="Cronología"
  description="Todos los hechos documentados del Caso Zapatero y el Caso Koldo, ordenados cronológicamente."
>
  <div class="container" style="padding-top: 2.5rem; padding-bottom: 4rem;">
    <div style="margin-bottom: 2rem;">
      <p style="font-family:'IBM Plex Mono',monospace;font-size:0.72rem;color:var(--txt3);text-transform:uppercase;letter-spacing:0.08em;margin:0 0 0.5rem;">
        Cronología completa
      </p>
      <h1 style="font-size:clamp(1.8rem,4vw,2.8rem);margin:0 0 0.5rem;">
        {events.length} hechos documentados
      </h1>
      <p style="font-size:0.9rem;color:var(--txt2);margin:0;">
        Ordenados cronológicamente. Fuentes verificadas en cada evento.
      </p>
    </div>

    <CronologiaClient
      events={events}
      entities={entities}
      sources={sources}
      tipos={tipos}
      client:load
    />
  </div>
</Base>
