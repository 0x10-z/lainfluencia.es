---
import Base from '../layouts/Base.astro'
import PersonajesClient from '../components/PersonajesClient.tsx'

import entitiesData from '../data/entities.json'
import type { Entity } from '../types'

const entities = (entitiesData.entities as Entity[]).filter(e =>
  e.cases.includes('dp-77-24')
)
---

<Base
  title="Personajes"
  description="Todos los actores del Caso Zapatero: investigados, acusados, testigos e instituciones."
>
  <!-- Cabecera -->
  <div style="padding:2rem 3vw 1.5rem; border-bottom:1px solid var(--line);">
    <div style="font-family:var(--fm); font-size:0.5rem; color:var(--txt3); text-transform:uppercase; letter-spacing:0.18em; margin-bottom:0.5rem;">
      Personajes · Actores del caso
    </div>
    <h1 style="font-family:var(--ft); font-size:clamp(1.8rem,4vw,2.8rem); font-weight:900; letter-spacing:-0.025em; margin-bottom:0.4rem; line-height:1.05;">
      {entities.length} actores documentados
    </h1>
    <p style="font-family:var(--fb); font-size:0.85rem; color:var(--txt2); margin:0; max-width:520px; line-height:1.6;">
      Pulsa cualquier ficha para ver relaciones, eventos y fuentes. Estado procesal según el auto del juez Calama.
    </p>
  </div>

  <PersonajesClient entities={entities} client:load />
</Base>
