---
import Base from '../layouts/Base.astro'
import GraphD3 from '../components/GraphD3.tsx'

import entitiesData from '../data/entities.json'
import relationsData from '../data/relations.json'

import type { Entity, Relation } from '../types'

const entities = entitiesData.entities as Entity[]
const relations = relationsData.relations as Relation[]
---

<Base
  title="Red de relaciones"
  description="Mapa visual de las relaciones entre actores del Caso Zapatero y el Caso Koldo."
>
  <!-- Cabecera -->
  <div class="container" style="padding: 2rem 0 1rem;">
    <p style="font-family:'IBM Plex Mono',monospace;font-size:0.72rem;color:var(--txt3);text-transform:uppercase;letter-spacing:0.08em;margin:0 0 0.5rem;">
      Red de relaciones
    </p>
    <h1 style="font-size:clamp(1.6rem,3.5vw,2.4rem);margin:0 0 0.5rem;">
      {entities.length} actores · {relations.length} vínculos documentados
    </h1>
    <p style="font-size:0.85rem;color:var(--txt2);margin:0;">
      Arrastra para mover nodos. Rueda para hacer zoom. Pulsa un nodo para ver su ficha.
    </p>
  </div>

  <!-- Leyenda -->
  <div class="container" style="padding: 0.75rem 0; border-bottom: 1px solid var(--line);">
    <div style="display:flex;flex-wrap:wrap;gap:1.5rem;align-items:center;">
      {[
        { color: 'var(--red)', label: 'Caso Zapatero' },
        { color: 'var(--blue)', label: 'Caso Koldo' },
        { color: 'var(--gold)', label: 'Ambos casos' },
        { color: 'var(--txt3)', label: 'Sin caso directo' },
      ].map(({ color, label }) => (
        <span style="display:flex;align-items:center;gap:6px;">
          <span style={`width:10px;height:10px;border-radius:50%;border:1.5px solid ${color};background:${color}33;display:inline-block;`} />
          <span style="font-family:'IBM Plex Mono',monospace;font-size:0.7rem;color:var(--txt2);">{label}</span>
        </span>
      ))}
      <span style="margin-left:auto;font-family:'IBM Plex Mono',monospace;font-size:0.68rem;color:var(--txt3);">
        Líneas continuas = verificado · Líneas discontinuas = parcial
      </span>
    </div>
  </div>

  <!-- Grafo -->
  <div style="height: calc(100vh - 200px); min-height: 500px; border-bottom: 1px solid var(--line);">
    <GraphD3 entities={entities} relations={relations} client:load />
  </div>

  <!-- Lista de relaciones -->
  <div class="container" style="padding: 3rem 0;">
    <h2 style="font-family:'IBM Plex Mono',monospace;font-size:0.72rem;color:var(--txt3);text-transform:uppercase;letter-spacing:0.08em;margin:0 0 1.5rem;font-weight:400;">
      Todas las relaciones documentadas
    </h2>
    <div style="display:flex;flex-direction:column;gap:1px;background:var(--line);">
      {relations.map(r => {
        const from = entities.find(e => e.id === r.from)
        const to = entities.find(e => e.id === r.to)
        const borderColor = r.cases.includes('dp-77-24') && r.cases.includes('caso-koldo')
          ? 'var(--gold)' : r.cases.includes('dp-77-24') ? 'var(--red)' : 'var(--blue)'
        return (
          <div style={`background:var(--bg2);border-left:3px solid ${borderColor};padding:0.85rem 1.25rem;display:flex;flex-wrap:wrap;gap:1rem;align-items:center;`}>
            <a href={from ? `/personajes/${from.id}` : '#'} style="font-size:0.88rem;color:var(--txt);text-decoration:none;font-weight:600;">
              {from?.name ?? r.from}
            </a>
            <span style="font-family:'IBM Plex Mono',monospace;font-size:0.7rem;color:var(--txt3);padding:2px 8px;border:1px solid var(--line2);">
              {r.label}
            </span>
            <a href={to ? `/personajes/${to.id}` : '#'} style="font-size:0.88rem;color:var(--txt);text-decoration:none;font-weight:600;">
              {to?.name ?? r.to}
            </a>
            {r.amount?.value != null && (
              <span style="font-family:'IBM Plex Mono',monospace;font-size:0.78rem;color:var(--gold);margin-left:auto;">
                {r.amount.approximate ? '~' : ''}{r.amount.value.toLocaleString('es-ES')} {r.amount.currency}
              </span>
            )}
          </div>
        )
      })}
    </div>
  </div>
</Base>
